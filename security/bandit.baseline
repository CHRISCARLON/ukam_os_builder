      "code": "164     con.execute(\"DROP TABLE IF EXISTS lpi_base_full\")\n165     con.execute(f\"\"\"\n166         CREATE TEMPORARY TABLE lpi_base_full AS\n167         SELECT\n168             l.uprn,\n169             l.lpi_key,\n170             l.language,\n171             l.logical_status,\n172             l.official_flag,\n173             l.start_date,\n174             l.end_date,\n175             l.last_update_date,\n176             b.postcode_locator AS postcode,\n177             b.blpu_state,\n178             b.addressbase_postal AS postal_address_code,\n179             b.parent_uprn,\n180             CASE\n181                 WHEN b.parent_uprn IS NOT NULL THEN 'C'\n182                 WHEN hc.uprn IS NOT NULL THEN 'P'\n183                 ELSE 'S'\n184             END AS hierarchy_level,\n185             l.level,\n186             COALESCE(sd_lang.street_description, sd_any.street_description) AS street_description,\n187             COALESCE(sd_lang.locality, sd_any.locality) AS locality_name,\n188             COALESCE(sd_lang.town_name, sd_any.town_name) AS town_name,\n189             build_base_address(\n190                 l.sao_text, l.sao_start_number, l.sao_start_suffix, l.sao_end_number, l.sao_end_suffix,\n191                 l.pao_text, l.pao_start_number, l.pao_start_suffix, l.pao_end_number, l.pao_end_suffix,\n192                 COALESCE(sd_lang.street_description, sd_any.street_description),\n193                 COALESCE(sd_lang.locality, sd_any.locality),\n194                 COALESCE(sd_lang.town_name, sd_any.town_name)\n195             ) AS base_address,\n196             CASE l.logical_status\n197                 WHEN 1 THEN 0\n198                 WHEN 3 THEN 1\n199                 WHEN 6 THEN 2\n200                 WHEN 8 THEN 3\n201                 ELSE 9\n202             END AS status_rank\n203         FROM lpi l\n204         JOIN blpu b ON b.uprn = l.uprn\n205         LEFT JOIN parent_uprns_with_children hc ON hc.uprn = l.uprn\n206         LEFT JOIN _sd_best_by_lang sd_lang ON sd_lang.usrn = l.usrn AND sd_lang.language = l.language\n207         LEFT JOIN _sd_best_any sd_any ON sd_any.usrn = l.usrn\n208         WHERE (b.addressbase_postal != 'N' OR b.addressbase_postal IS NULL)\n209           AND l.logical_status IN ({logical_statuses_sql})\n210     \"\"\")\n211 \n",
